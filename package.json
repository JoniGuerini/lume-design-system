{
  "name": "lume-design-system",
  "version": "1.9.2",
  "private": true,
  "description": "Lume Design System — tokens, ícones, componentes e documentação.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build-tokens.mjs && node scripts/build-react.mjs && node scripts/test-figma-plugin.mjs && node scripts/build-site.mjs",
    "react": "node scripts/build-react.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "figma": "node scripts/build-figma-plugin.mjs",
    "ia": "node scripts/build-ai-docs.mjs",
    "figma:test": "node scripts/test-figma-plugin.mjs",
    "tokens:export": "node scripts/export-tokens.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "test:a11y": "node scripts/test-a11y.mjs",
    "stories": "node scripts/build-stories.mjs",
    "storybook": "cd storybook && npm run storybook",
    "npm:build": "node scripts/build-npm.mjs",
